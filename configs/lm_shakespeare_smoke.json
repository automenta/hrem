{
  "dataset": {
    "name": "tiny_shakespeare",
    "params": {
      "seq_length": 8,
      "split": "train"
    }
  },
  "experiment_name": "lm_shakespeare_smoke",
  "extends": "default.json",
  "model": {
    "name": "hrm",
    "params": {
      "H_cycles": 1,
      "H_layers": 1,
      "L_cycles": 1,
      "L_layers": 1,
      "batch_size": 4,
      "forward_dtype": "float32",
      "halt_max_steps": 1,
      "hidden_size": 4,
      "num_heads": 2,
      "seq_len": 8,
      "use_memory": false
    }
  },
  "training": {
    "batch_size": 1,
    "epochs": 1,
    "learning_rate": 0.001
  }
}