include "default.json"
  "experiment_name": "assoc_hrem_dnc",
  "model": {
    "name": "hrem",
    "params": {
      "seq_len": 80,
      "use_location_addressing": true,
      "puzzle_emb_ndim": 0,
      "num_puzzle_identifiers": 1,
      "expansion": 2.0,
      "num_heads": 4,
      "pos_encodings": "rope",
      "halt_exploration_prob": 0.1,
      "H_cycles": 1,
      "L_cycles": 1,
      "H_layers": 1,
      "L_layers": 1,
      "halt_max_steps": 1
    }
  },
  "dataset": {
    "name": "associative_recall",
    "params": {
      "item_range": [
        3,
        6
      ],
      "vec_len": 10,
      "train_size": 300,
      "test_size": 50
    }
  },
  "training": {
    "epochs": 1
  }