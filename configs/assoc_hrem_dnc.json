{
  "experiment_name": "assoc_hrem_dnc",
  "model": {
    "name": "hrem",
    "params": {
      "seq_len": 80,
      "d_model": 256,
      "n_cycles": 2,
      "t_steps": 30,
      "use_memory": true,
      "m_loc": 64,
      "d_mem": 40,
      "sparse_addressing": false,
      "use_location_addressing": true
    }
  },
  "dataset": {
    "name": "associative_recall",
    "params": {
      "item_range": [3, 6],
      "vec_len": 10,
      "train_size": 3000,
      "test_size": 500
    }
  },
  "training": {
    "epochs": 20,
    "batch_size": 32,
    "learning_rate": 0.0005
  }
}
