{
  "experiment_name": "rl_cartpole_hrem_dnc_smoke",
  "model": {
    "name": "hrem",
    "params": {
      "seq_len": 4,
      "d_model": 32,
      "n_cycles": 1,
      "t_steps": 1,
      "n_layers": 1,
      "use_memory": true,
      "m_loc": 16,
      "d_mem": 8,
      "sparse_addressing": false,
      "use_location_addressing": true
    }
  },
  "dataset": {
    "name": "gymnasium",
    "params": {
      "env_name": "CartPole-v1"
    }
  },
  "training": {
    "loss": "policy_gradient",
    "epochs": 1,
    "episodes_per_epoch": 5,
    "eval_episodes": 2,
    "learning_rate": 0.001,
    "gamma": 0.99
  }
}
