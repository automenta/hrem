{
  "experiment_name": "assoc_hrem_dnc_smoke",
  "model": {
    "name": "hrem",
    "params": {
      "d_model": 32,
      "n_layers": 2,
      "n_heads": 2,
      "n_cycles": 2,
      "use_memory": true,
      "m_loc": 16,
      "d_mem": 8,
      "use_location_addressing": true,
      "input_size": 8
    }
  },
  "dataset": {
    "name": "associative_recall",
    "params": {
      "item_range": [
        3,
        6
      ],
      "vec_len": 8,
      "train_size": 10,
      "test_size": 10
    }
  },
  "training": {
    "epochs": 1,
    "batch_size": 4,
    "learning_rate": 0.001
  }
}